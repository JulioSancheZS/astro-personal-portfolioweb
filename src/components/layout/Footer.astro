---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../data/site';
---

<footer class="border-t border-surface-border/50 mt-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="flex flex-col items-center md:items-start gap-2">
        <span class="text-lg font-bold text-white">JS<span class="text-primary-500">.</span></span>
        <p class="text-sm text-slate-500">
          &copy; {new Date().getFullYear()} Julio Sanchez. Todos los derechos reservados.
        </p>
      </div>

      <nav aria-label="Enlaces del pie de pagina">
        <ul class="flex flex-wrap justify-center gap-6 text-sm text-slate-500">
          <li><a href="#sobre-mi" class="hover:text-white transition-colors">Sobre mi</a></li>
          <li><a href="#experiencia" class="hover:text-white transition-colors">Experiencia</a></li>
          <li><a href="#proyectos" class="hover:text-white transition-colors">Proyectos</a></li>
          <li><a href="#servicios" class="hover:text-white transition-colors">Servicios</a></li>
          <li><a href="#contacto" class="hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </nav>

      <div class="flex items-center gap-4">
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-white transition-colors" aria-label="LinkedIn">
          <Icon name="linkedin" class="size-5" />
        </a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-white transition-colors" aria-label="GitHub">
          <Icon name="github" class="size-5" />
        </a>
        <a href={`mailto:${SITE.email}`} class="text-slate-500 hover:text-white transition-colors" aria-label="Email">
          <Icon name="mail" class="size-5" />
        </a>
      </div>
    </div>
  </div>
</footer>
