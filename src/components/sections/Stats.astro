---
const stats = [
  { value: 5, suffix: "+", label: "Anos de experiencia" },
  { value: 10, suffix: "+", label: "Tecnologias dominadas" },
  { value: 4, suffix: "+", label: "APIs construidas" },
  { value: 3, suffix: "", label: "Empresas atendidas" },
];
---

<section class="py-16 md:py-20 animate-on-scroll">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="rounded-2xl bg-surface border border-surface-border p-8 md:p-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <div
              class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-accent-400 counter"
              data-target={stat.value}
              data-suffix={stat.suffix}
            >
              0{stat.suffix}
            </div>
            <div class="mt-2 text-sm text-slate-500">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
