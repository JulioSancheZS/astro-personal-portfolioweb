---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent-500/20 rounded-full blur-[120px] mix-blend-screen opacity-60" />
    <div class="absolute top-40 left-0 w-[500px] h-[500px] bg-accent2-500/10 rounded-full blur-[100px] mix-blend-screen opacity-50" />
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col items-center text-center gap-8">
      <div class="animate-fade-in">
        <span class="inline-flex items-center gap-2 rounded-full bg-accent-500/10 border border-accent-500/30 px-4 py-1.5 text-sm text-accent-400 font-medium shadow-[0_0_15px_rgba(6,182,212,0.15)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-500"></span>
          </span>
          Servicios de Consultoría y Desarrollo
        </span>
      </div>

      <div class="relative animate-fade-in mt-4">
        <div class="absolute inset-0 bg-gradient-to-br from-accent-500/30 to-accent2-500/30 rounded-full blur-2xl animate-pulse-glow" />
        <img
          src="/logopersonal.png"
          alt="Julio Sanchez - Logo"
          class="relative h-28 md:h-32 w-auto drop-shadow-[0_0_25px_rgba(6,182,212,0.4)]"
          width="128"
          height="128"
          decoding="async"
        />
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-[1.1] animate-slide-up max-w-4xl">
        Digitalizo tu negocio para hacerlo
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-400 via-accent2-400 to-accent-400">
          más rentable y eficiente
        </span>
      </h1>

      <p class="text-lg md:text-xl text-primary-300 max-w-2xl leading-relaxed animate-slide-up-delayed opacity-0">
        Desarrollo <strong class="text-white font-semibold">sistemas a medida, automatizaciones y aplicaciones web</strong>. 
        Ayudo a empresas a optimizar su tiempo, reducir costos operativos y escalar.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4 w-full sm:w-auto animate-slide-up-delayed opacity-0">
        <Button href="#contacto" variant="primary" class="w-full sm:w-auto px-8">
          Cotizar mi Proyecto
          <Icon name="mail" class="size-4" />
        </Button>
        <Button href="#servicios" variant="secondary" class="w-full sm:w-auto px-8">
          Ver Servicios
          <Icon name="arrow-right" class="size-4" />
        </Button>
      </div>

      <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 mt-4 text-sm text-primary-400 font-medium animate-slide-up-delayed opacity-0">
        <span class="flex items-center gap-2">
          <Icon name="briefcase" class="size-4 text-accent-400" />
          +5 años de experiencia
        </span>
        <span class="flex items-center gap-2">
          <Icon name="sparkles" class="size-4 text-accent2-400" />
          Soluciones Personalizadas
        </span>
      </div>
    </div>
  </div>
</section>
