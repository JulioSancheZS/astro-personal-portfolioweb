---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = "", hover = true } = Astro.props;
---

<div
  class:list={[
    "rounded-2xl bg-surface border border-surface-border p-6",
    hover && "transition-all duration-300 hover:border-primary-700 hover:bg-surface-elevated/50 hover:shadow-2xl hover:shadow-black/50 hover:-translate-y-1",
    className,
  ]}
>
  <slot />
</div>
