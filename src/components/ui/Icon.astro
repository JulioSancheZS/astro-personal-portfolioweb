const viewBoxMap: Record<string, string> = {
  github: "0 0 256 250",
  linkedin: "0 0 256 256",
  mail: "0 0 24 24",
  whatsapp: "0 0 24 24",
  "arrow-right": "0 0 24 24",
  "arrow-up": "0 0 24 24",
  "external-link": "0 0 24 24",
  menu: "0 0 24 24",
  close: "0 0 24 24",
  download: "0 0 24 24",
  briefcase: "0 0 24 24",
  code: "0 0 24 24",
  "chevron-down": "0 0 24 24",
  "map-pin": "0 0 24 24",
  calendar: "0 0 24 24",
  trophy: "0 0 24 24",
  brain: "0 0 24 24",
  sparkles: "0 0 24 24",
  "star-filled": "0 0 24 24",
};

const svgContent = icons[name] ?? "";
const viewBox = viewBoxMap[name] ?? "0 0 24 24";
const isHeroicons = !!viewBoxMap[name] && name !== "github" && name !== "linkedin";
---

{svgContent ? (
  <svg
    class={className}
    id={id}
    viewBox={viewBox}
    fill={isHeroicons ? "none" : "currentColor"}
    stroke={isHeroicons ? "currentColor" : "none"}
    stroke-width={isHeroicons ? "1.5" : "0"}
    stroke-linecap="round"
    stroke-linejoin="round"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <Fragment set:html={svgContent} />
  </svg>
) : (
  <span class:list={["inline-flex items-center justify-center font-bold text-primary-400", className]}>
    {name.charAt(0).toUpperCase()}
  </span>
)}
